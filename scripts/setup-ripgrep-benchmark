#!/usr/bin/env bash
set -euo pipefail

workspace=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
benchmark_dir="$workspace/.benchmark"
ripgrep_dir="$benchmark_dir/ripgrep"
ripgrep_commit=3fce3b5bb0236da2df6d99672afb8a719642eca7

if [[ -L "$benchmark_dir" || ( -e "$benchmark_dir" && ! -d "$benchmark_dir" ) ]]; then
    printf 'Error: %s must be a directory, not a file or symlink.\n' "$benchmark_dir" >&2
    exit 1
fi

if [[ -d "$benchmark_dir" && -n "$(find "$benchmark_dir" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
    printf 'Error: %s is not empty.\n' "$benchmark_dir" >&2
    exit 1
fi

for command in git rg cargo; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf 'Error: %s is required.\n' "$command" >&2
        exit 1
    fi
done

mkdir -p "$benchmark_dir"
git clone https://github.com/BurntSushi/ripgrep.git "$ripgrep_dir"
git -C "$ripgrep_dir" checkout --detach "$ripgrep_commit"

rg_version=$(rg --version)
printf 'Installed ripgrep: %s\n' "${rg_version%%$'\n'*}"

cargo build --manifest-path "$workspace/Cargo.toml"
printf 'Built srcsearch: '
"$workspace/target/debug/srcsearch" --version
